# Firebase Console > Project settings > General > Your apps > Web app config.
# Public identifiers only. Never put a service-account key or client secret here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Native Google sign-in (optional; email/password works without these).
# Use the OAuth client of type WEB for Android/iOS ID-token audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# OAuth client of type iOS, with the app's exact bundle identifier.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Retained ArcGIS renderer; not used by the active Google maps.
EXPO_PUBLIC_ARCGIS_API_KEY=

# Active Google Maps keys for Android/iOS builds and the browser.
# See docs/GOOGLE_MAPS_SETUP.md for platform restrictions and rebuilds.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# Optional web map ID. DEMO_MAP_ID is used for local testing if left empty.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_MAP_ID=

# Optional LOCAL development tests only: demo- project + Auth9099/Firestore8080.
# Leave empty for real Firebase projects and release builds.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
